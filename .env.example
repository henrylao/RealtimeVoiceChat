# Native-serve config (copied to .env or exported). No Docker / bundled Ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLAMA_BASE_URL=http://127.0.0.1:8081/v1
LLM_PROVIDER=llamacpp
LLM_MODEL=gemma-4-12B-it-qat-UD-Q4_K_XL
TTS_ENGINE=kokoro
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.26
LOG_LEVEL=INFO
MAX_AUDIO_QUEUE_SIZE=50
# Assistant voice loudness: DISABLED by default (plain resampled audio,
# exactly the original behavior). Set TTS_LOUDNESS_ENABLED=true to opt into
# the boost chain below (fixed gain + optional compressor + -1 dBFS ceiling).
# TTS_LOUDNESS_ENABLED=false
# TTS_GAIN_DB=12.0
# TTS_CEILING_DB=-1.0
# Broadcast compressor: off by default (plain gain + limiter). Set to true
# for denser, squashed voice at the same peak level.
# TTS_COMP_ENABLED=false
# Broadcast compressor (threshold post-gain, ratio, attack/release, makeup, gate)
# TTS_COMP_THRESHOLD_DB=-24.0
# TTS_COMP_RATIO=3.0
# TTS_COMP_ATTACK_MS=2.0
# TTS_COMP_RELEASE_MS=120.0
# TTS_COMP_MAKEUP_DB=12.0
# TTS_COMP_GATE_DB=-50.0
# TTS_COMP_LOOKAHEAD_MS=3.0
# Opt-in per-turn audio collection (default off)
# AUDIO_DUMP=true
# AUDIO_DUMP_DIR=/home/hanz/RealtimeVoiceChat/data/sessions
# AUDIO_DUMP_RETENTION_GB=50
# AUDIO_DUMP_RETENTION_DAYS=30
# RTX 2080 Ti (sm75) builds
TORCH_CUDA_ARCH_LIST=7.5
